module system (system)
  cell top_instance : top
    conn a (input) <- var sys_a : logic[3:0]
    conn b (input) <- var sys_b : logic[3:0]
    conn sum (output) <- var sys_sum : logic[4:0]
    cell my_adder : adder
      conn a (input) <- var a : logic[3:0]
      conn b (input) <- var b : logic[3:0]
      conn sum (output) <- var sum : logic[4:0]
